{
  "name": "hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "probe:auth": "node scripts/auth-admin-es256-probe.mjs",
    "walk:cast": "node scripts/walk-cast.mjs",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration --runInBand --verbose",
    "test:integration:quick": "jest tests/integration --runInBand --bail --verbose",
    "test:integration:auth": "jest tests/integration/auth --runInBand --verbose",
    "test:integration:groups": "jest tests/integration/groups --runInBand --verbose",
    "test:integration:journeys": "jest tests/integration/journeys --runInBand --verbose",
    "test:integration:admin": "jest tests/integration/admin --runInBand --verbose",
    "test:integration:communication": "jest tests/integration/communication --runInBand --verbose",
    "test:integration:security": "jest tests/integration/security --runInBand --verbose",
    "test:integration:account": "jest tests/integration/account --runInBand --verbose",
    "test:integration:journal": "jest tests/integration/journal --runInBand --verbose",
    "test:integration:observability": "jest tests/integration/observability --runInBand --verbose",
    "test:integration:platform": "jest tests/integration/platform --runInBand --verbose",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug"
  },
  "dependencies": {
    "@supabase/ssr": "^0.8.0",
