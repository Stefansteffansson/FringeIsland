# TypeScript
*.tsbuildinfo
next-env.d.ts

# Testing
coverage
.nyc_output

# Playwright E2E
test-results/
playwright-report/
# Playwright auth state holds live session tokens — never commit it.
# Un-anchored on purpose: this must reach every surface (hub/, later gimbal/,
# studio surfaces) at any depth. The old root-anchored form silently protected
# nothing after the ADR-U032 relocation moved tests under hub/.
**/tests/e2e/.auth/

# Vercel
.vercel

# Supabase
supabase/.temp/
.supabase/

# Office lock files
~$*

# Native-addon temp copies: dot-prefixed content-hash names (e.g. .5cf45fd79f3fef6d-00000000.node)
# extracted into the cwd at runtime by bundled tooling on Windows. Regenerable, never needed.
# Deliberately NOT a blanket *.node — legitimate native addons are never dot-prefixed.
.*-????????.node

# Scratch / temporary docs
docs/TMP/

# Generated project dashboard (regenerate with `npm run dashboard`; generator lives in scripts/dashboard/)
docs/dashboard/

# Reader-tour distribution artefacts (markdown is source of truth; .docx not committed)
docs/products/**/*.docx
docs/platform/**/*.docx
docs/studios/**/*.docx
docs/design-system/**/*.docx
docs/verticals/**/*.docx

# Machine-local Claude Code instructions (auto-loaded, never committed)
CLAUDE.local.md

# Skills-CLI junctions into .agents/skills/ (machine-local NTFS links; real content
# is committed under .agents/skills/, provenance in skills-lock.json)
.claude/skills/supabase/
.claude/skills/supabase-postgres-best-practices/

# Scratch dirs from tooling (never source)
git-blob-*/

# perf-measure.mjs output (local measurement runs)
hub/scripts/perf-results.jsonl
hub/scripts/perf-state.json

# Obsidian files
.obsidian/workspace.json
.obsidian/cache/